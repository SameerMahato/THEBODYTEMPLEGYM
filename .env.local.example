# Copy this file to .env.local and fill in your values.
# Supabase values come from your project -> Settings -> API Keys.

# Public. Both are compiled into the browser bundle at build time, so neither
# is a secret -- but because they are baked in at build time, they must be set
# for Production, Preview AND Development in Vercel, or preview deployments
# will build with them undefined and fail to reach Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Secret. Bypasses RLS entirely. Used only by scripts/seed.ts, never by
# application code, and never set in Vercel.
# Newer projects issue this as sb_secret_...; older ones as a service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# Used by scripts/seed.ts when it creates the first admin account. Without
# them the script falls back to defaults hardcoded in that file, which are
# committed to this repository -- set these rather than rely on them.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# The URL where this app is deployed. The public /join page is statically
# rendered and cannot read request headers, so its QR code is omitted
# entirely when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
